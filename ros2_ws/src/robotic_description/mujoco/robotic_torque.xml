<mujoco model="robotic_torque">
  <!-- Standalone direct-torque simulation.
       The arm itself (platform + chain + joints + actuators) lives in
       robotic_arm.xml; this file only adds floor, lighting and skybox. -->

  <include file="robotic_arm.xml" />

  <!-- Basic simulation settings follow wheeled_robot.xml. -->
  <option timestep="0.002" gravity="0 0 -9.81" />
  <visual>
    <rgba haze="0.4 0.6 0.8 1" />
  </visual>

  <asset>
    <!-- Ground and sky style copied from wheeled_robot.xml. -->
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.4 0.6 0.8"
      rgb2="0 0 0"
      width="512"
      height="512" />
    <texture
      name="texplane"
      type="2d"
      builtin="checker"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.15 0.2"
      width="512"
      height="512"
      mark="cross"
      markrgb="0.8 0.8 0.8" />
    <material
      name="matplane"
      reflectance="0.2"
      texture="texplane"
      texrepeat="1 1"
      texuniform="true" />
  </asset>

  <worldbody>
    <light pos="0.6 -0.8 1.5" dir="-0.2 0.3 -1" directional="true" />
    <geom
      name="floor"
      type="plane"
      pos="0 0 -0.001"
      size="5 5 0.1"
      material="matplane"
      contype="1"
      conaffinity="1" />
  </worldbody>
</mujoco>
