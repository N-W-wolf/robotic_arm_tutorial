<mujoco model="task_competition_scene">
  <!-- The teaching scene reuses the field and target assets without the Black quadruped. -->

  <!-- The robotic arm (platform + arm chain + actuators) is provided by the
       robotic_description package. The viewer replaces this placeholder with
       the installed robotic_arm.xml path before loading. -->
  <include file="__ARM_MODEL_PATH__" />

  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -9.81" iterations="40" integrator="RK4"/>

  <visual>
    <global azimuth="145" elevation="-28"/>
    <headlight ambient="0.10 0.10 0.12" diffuse="0.38 0.38 0.38" specular="0.03 0.03 0.03"/>
    <rgba haze="0.88 0.92 0.98 1.0"/>
