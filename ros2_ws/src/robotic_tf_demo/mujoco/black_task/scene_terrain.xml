    <texture name="display_board_tex" type="2d" file="assets/display_board.png"/>
    <mesh name="label_quad_mesh" file="assets/label_quad.obj" inertia="shell"/>
    <mesh name="display_quad_mesh" file="assets/display_quad.obj" inertia="shell"/>

    <material name="outside_floor_mat" rgba="0.82 0.82 0.84 1" reflectance="0.02" shininess="0.01" specular="0.02"/>
