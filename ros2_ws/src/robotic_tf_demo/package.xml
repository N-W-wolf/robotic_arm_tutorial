<?xml version="1.0"?>
<package format="3">
  <name>robotic_tf_demo</name>
  <version>0.1.0</version>
  <description>ROS 2 TF teaching demo using the Black competition scene resources.</description>
  <maintainer email="teaching@example.com">Teaching Project</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robotic_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rqt_tf_tree</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
